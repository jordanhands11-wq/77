# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign authentication session tokens on the server.
SESSION_SECRET="CHANGE_ME_SESSION_SECRET"

# ADMIN_BOOTSTRAP_EMAIL / ADMIN_BOOTSTRAP_PASSWORD: Optional admin account seeded on boot.
# Leave empty unless provisioning an administrator account.
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_PASSWORD=""

# SMTP_HOST / SMTP_PORT / SMTP_USER / SMTP_PASS: Optional SMTP relay for live verification & reset emails.
# When unconfigured, verification/reset tokens operate in local dev/test preview mode only.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# MARKET_DATA_TIMEOUT_MS: Optional upstream timeout (ms) for server-side free public market feeds
# (Binance Public Vision & Coinbase Exchange public endpoints require zero paid API keys).
MARKET_DATA_TIMEOUT_MS="4500"

# FUTURE PAYMENT ADAPTER PLACEHOLDERS (Server-Side Only — Live Processing Strictly Disabled)
# Leave empty during development/paper-trading. Never expose payment secrets to the client bundle.
BANK_PROVIDER_CLIENT_ID=""
BANK_PROVIDER_SECRET=""
BANK_WEBHOOK_SECRET=""
CARD_GATEWAY_SECRET_KEY=""
CARD_GATEWAY_WEBHOOK_SECRET=""

